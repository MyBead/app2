{
  "expo": {
    "name": "Okazje",
    "slug": "okazje",
    "scheme": "okazje",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.okazje.app"
    },
    "android": {
      "package": "pl.okazje.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Okazje использует местоположение, чтобы найти ближайшие магазины для списка покупок."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Okazje использует камеру, чтобы сканировать штрихкоды товаров и искать их в акциях.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HotDeals",
              "label": "Okazje — лучшие акции",
              "description": "Самые выгодные акции под ваши предпочтения",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
